# Audiobookshelf MCP Server Configuration

# Required: Audiobookshelf server URL
ABS_URL=https://your-audiobookshelf-instance.example.com

# Required: Audiobookshelf API token (Bearer token)
ABS_TOKEN=your_audiobookshelf_api_token

# Optional: MCP transport settings
# ABS_MCP_TRANSPORT=sse
# ABS_MCP_HOST=0.0.0.0
# ABS_MCP_PORT=6977
# ABS_MCP_LOG_LEVEL=INFO
# ABS_MCP_DISABLE=false
